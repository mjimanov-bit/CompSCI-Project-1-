
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Forecast</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

    <main class="app-container">
        <header>
            <p class="eyebrow">DAILY WEATHER</p>
            <h1>Weather Forecast</h1>
            <p class="subtitle">Discover the weather somewhere in the world.</p>
        </header>

        <section class="weather-card">
            <p id="city">Your forecast is waiting</p>

            <div id="icon" class="weather-icon">🌤️</div>

            <h2 id="condition">Click below to generate a forecast</h2>

            <div class="temperatures">
                <div>
                    <span class="temperature-label">HIGH</span>
                    <p id="high">--°</p>
                </div>

                <div>
                    <span class="temperature-label">LOW</span>
                    <p id="low">--°</p>
                </div>
            </div>

            <button onclick="generateForecast()">
                Generate Forecast
            </button>

            <p id="status">Ready to forecast</p>
        </section>

        <footer>
            Random Forecaster • Powered by Python
        </footer>
    </main>

    <script>
        async function generateForecast() {
            const status = document.getElementById("status");

            status.textContent = "Loading forecast...";

            try {
                const response = await fetch("/forecast");
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error);
                }

                document.getElementById("city").textContent = data.city;
                document.getElementById("icon").textContent = data.icon;
                document.getElementById("condition").textContent = data.condition;
                document.getElementById("high").textContent = data.high + "°";
                document.getElementById("low").textContent = data.low + "°";

                status.textContent = "Forecast generated successfully";

            } catch (error) {
                status.textContent = "Could not load forecast.";
                console.error(error);
            }
        }
    </script>

</body>
</html>
